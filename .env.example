# Environment example for local development
# Copy to `.env` and replace placeholders

# Supabase (Frontend)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# OpenRouter (Edge Functions and optional frontend usage)
# Create a key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-your-key"

# Optional overrides
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# VITE_APP_URL="http://localhost:8080"    # Used for referer in edge functions
# APP_URL="http://localhost:8080"          # Alternative app URL for server referer
# ALLOWED_ORIGINS="http://localhost:8080,http://localhost:8081"  # CORS allowlist for functions
# RL_WINDOW_MS="60000"    # Rate limiter window (ms)
# RL_MAX="60"             # Max requests per window